# Required when Firebase chat persistence is implemented in Phase 3.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=

# Phase 2 server-side AI. Upstash index: 1536 dimensions, cosine, caller-provided vectors.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_EMBEDDING_MODEL=gemini-embedding-2
AI_EMBEDDING_DIMENSIONS=1536
AI_TOP_K=5
AI_MAX_OUTPUT_TOKENS=700
AI_MAX_MESSAGE_LENGTH=1200
AI_MAX_CONVERSATION_CHARACTERS=2400
AI_TIMEOUT_MS=20000
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
UPSTASH_VECTOR_NAMESPACE=makkahwi-ai-v1

# Planned for public endpoint hardening.
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=60
